{
  "description": "Depuis une carte média : insère l'image dans la lightbox ImageOnClick",
  "isMediaSnippet": true,
  "body": [
    "<ImageOnClick imageUrl=\"[[&mediaUrl]]\" altText=\"[[&alt]]\" buttonName=\"[[&buttonName]]\" className=\"[[imageClass]]\" />"
  ],
  "fields": [
    {
      "name": "buttonName",
      "title": "Libellé du lien",
      "type": "string",
      "default": "Voir l'image"
    },
    {
      "name": "imageClass",
      "title": "Classe de l'image",
      "type": "choice",
      "choices": [
        "",
        "margin-vert--md",
        "margin-vert--lg",
        "shadow--lw",
        "shadow--md",
        "shadow--tl"
      ],
      "default": ""
    }
  ],
  "id": "Lightbox",
  "title": "Lightbox"
}
