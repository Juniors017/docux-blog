{
  "description": "From a media card: insert the image into the ImageOnClick lightbox",
  "isMediaSnippet": true,
  "body": [
    "<ImageOnClick imageUrl=\"[[&mediaUrl]]\" altText=\"[[&alt]]\" buttonName=\"[[&buttonName]]\" className=\"[[imageClass]]\" />"
  ],
  "fields": [
    {
      "name": "buttonName",
      "title": "Link label",
      "type": "string",
      "default": "View the image"
    },
    {
      "name": "imageClass",
      "title": "Image class",
      "type": "choice",
      "choices": [
        "",
        "margin-vert--md",
        "margin-vert--lg",
        "shadow--lw",
        "shadow--md",
        "shadow--tl"
      ],
      "default": ""
    }
  ],
  "id": "Lightbox",
  "title": "Lightbox"
}
